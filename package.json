{
  "name": "react-dispatch",
  "version": "2.0.0",
  "description": "Tiny, dependency-free, type-safe event dispatcher for React and JavaScript applications.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.types.json",
    "build:js": "esbuild src/index.ts --bundle --platform=neutral --format=esm --target=es2020 --sourcemap --outfile=dist/index.js && esbuild src/index.ts --bundle --platform=neutral --format=cjs --target=es2020 --sourcemap --outfile=dist/index.cjs",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaohuangguan/react-dispatch.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "event-emitter",
    "event-bus",
    "react",
    "typescript",
    "dispatch",
    "pubsub",
    "react-dispatch"
  ],
  "author": "Sam Yao",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yaohuangguan/react-dispatch/issues"
  },
  "homepage": "https://github.com/yaohuangguan/react-dispatch#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
